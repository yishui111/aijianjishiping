# 方案模型（对话 / 出 EDL）
# 线上 DeepSeek：
PLANNER_BASE_URL=https://api.deepseek.com/v1
PLANNER_MODEL=deepseek-chat
PLANNER_API_KEY=sk-xxxxxxxx

# 或全本地（Ollama，素材完全不出本地）：
# PLANNER_BASE_URL=http://localhost:11434/v1
# PLANNER_MODEL=qwen2.5vl:3b
# PLANNER_API_KEY=

# 理解层模型（Ollama）
VLM_MODEL=qwen2.5vl:3b
NUM_CTX=8192
# 视觉大模型开关：auto=先试，连续失败自动转 CLIP 标注 / false=彻底关掉（本机跑不动 VLM 时用）
# 关掉后分析照常出场景切分/关键帧/CLIP 向量/转写，场景描述由 Chinese-CLIP 零样本标注兜底
VLM_ENABLED=auto

# 语音转写设备：auto=自动 / cpu=强制 CPU（机器缺 CUDA 运行库如 cublas64_12.dll 时设 cpu）
ASR_DEVICE=auto
ASR_CPU_THREADS=4

# 剧本生成专用（线上 DeepSeek）：只影响"生成剧本"，对话仍走上面配置。
# 填 GEN_SCRIPT_API_KEY 后剧本用 DeepSeek 生成（已约定：镜头描述必须用场记词汇，保证向量匹配准）。
GEN_SCRIPT_BASE_URL=https://api.deepseek.com/v1
GEN_SCRIPT_MODEL=deepseek-chat
GEN_SCRIPT_API_KEY=sk-xxxxxxxx
